	"tokenColors": [
		{
			"scope": [
				"bold",
				"markup.bold",
				"markup.heading",
				"markup.strong",
				"strong",
			],
			"settings": {
				"fontStyle": "bold",
			}
		},
		{
			"scope": [
				"emphasis",
				"italic",
				"keyword.control",
				"markup.italic.markdown",
			],
			"settings": {
				"fontStyle": "italic",
			}
		},
		{
			"scope": [
				"markup.underline",
			],
			"settings": {
				"fontStyle": "underline",
			}
		},
		{
			"scope": [
				"markup.strikethrough",
			],
			"settings": {
				"fontStyle": "strikethrough",
			}
		},
		{
			"scope": [
				"comment",
			],
			"settings": {
				"foreground": "#${gray7}",
				"fontStyle": "italic",
			}
		},
		{
			"scope": [
				"entity.name.filename.find-in-files",
				"markup.changed",
				"markup.list",
				"markup.underline.link.image.markdown",
				"markup.underline.link.markdown",
				"string",
			],
			"settings": {
				"foreground": "#e6db74",
			}
		},
		{
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded",
			],
			"settings": {
				"foreground": "#${color1}",
			}
		},
		{
			"scope": [
				"markup.list.numbered.markdown",
				"markup.list.unnumbered.markdown",
				"meta.template.expression",
			],
			"settings": {
				"foreground": "#${color15}",
			}
		},
		{
			"scope": [
				"variable",
			],
			"settings": {
				"foreground": "#${color15}",
				"fontStyle": "",
			}
		},
		{
			"scope": [
				"constant.character",
				"constant.language",
				"constant.numeric",
				"constant.other",
				"string.other.link.description.markdown",
				"string.other.link.title.markdown",
			],
			"settings": {
				"foreground": "#ae81ff",
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"storage",
			],
			"settings": {
				"foreground": "#${color1}",
				"fontStyle": "",
			}
		},
		{
			"scope": [
				"keyword",
				"markup.deleted",
				"markup.quote",
			],
			"settings": {
				"foreground": "#${color1}",
			}
		},
		{
			"scope": [
				"storage.type",
				"variable.language",
			],
			"settings": {
				"foreground": "#${color14}",
				"fontStyle": "italic",
			}
		},
		{
			"scope": [
				"support.class",
				"support.constant",
				"support.function",
				"support.type",
			],
			"settings": {
				"foreground": "#${color14}",
				"fontStyle": "",
			}
		},
		{
			"scope": [
				"markup.bold",
				"markup.italic",
			],
			"settings": {
				"foreground": "#${color14}",
			}
		},
		{
			"scope": [
				"storage.modifier",
			],
			"settings": {
				"fontStyle": "italic",
			}
		},
		{
			"scope": [
				"entity.name.class",
				"entity.name.function",
				"entity.name.namespace",
				"entity.name.scope-resolution",
				"entity.name.type",
				"markup.heading.setext",
			],
			"settings": {
				"foreground": "#${color2}",
				"fontStyle": "",
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
			],
			"settings": {
				"foreground": "#${color2}",
				"fontStyle": "italic",
			}
		},
		{
			"scope": [
				"entity.other.inherited-class",
				"markup.heading",
				"markup.inserted",
				"punctuation.definition.list.begin.markdown",
			],
			"settings": {
				"foreground": "#${color2}",
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"variable.parameter",
			],
			"settings": {
				"foreground": "#${color3}",
				"fontStyle": "",
			}
		},
		{
			"scope": [
				"support.other.variable",
			],
			"settings": {
				"fontStyle": "",
			}
		},
		{
			"scope": [
				"meta.structure.dictionary.json",
				"string.quoted.double.json",
			],
			"settings": {
				"foreground": "#${foreground}",
			}
		},
		{
			"scope": [
				"meta.diff",
			],
			"settings": {
				"foreground": "#${gray9}",
			}
		},
		{
			"scope": [
				"markup.quote.markdown",
			],
			"settings": {
				"foreground": "#${gray9}",
				"fontStyle": "italic",
			}
		},
		{
			"scope": [
				"token.info-token",
			],
			"settings": {
				"foreground": "#${color12}",
			}
		},
		{
			"scope": [
				"token.warn-token",
			],
			"settings": {
				"foreground": "#${color3}",
			}
		},
		{
			"scope": [
				"invalid",
				"token.error-token",
			],
			"settings": {
				"foreground": "#f44747",
			}
		},
		{
			"scope": [
				"token.debug-token",
			],
			"settings": {
				"foreground": "#ae81ff",
			}
		},
	],
}
