		"tab.activeBorder": "#${color1}",
		"tab.activeBorderTop": "#${gray5}",
		"tab.activeForeground": "#${color15}",
		"tab.border": "#${color0}",
		"tab.hoverBackground": "#${color0}",
		"tab.hoverBorder": "#${color3}",
		"tab.inactiveBackground": "#${color0}",
		"tab.inactiveForeground": "#${gray8}",
		"tab.lastPinnedBorder": "#${gray4}",
		"tab.selectedBackground": "#${gray2}",
		"tab.selectedBorderTop": "#${color1}",
		"tab.selectedForeground": "#${color15}a0",
		"tab.unfocusedActiveBorder": "#${color0}",
		"tab.unfocusedActiveBorderTop": "#${gray5}",
		"tab.unfocusedHoverBackground": "#${color0}",
