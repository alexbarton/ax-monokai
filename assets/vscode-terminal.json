{
    "vim.statusBarColorControl": true,
    "vim.statusBarColors.normal": ["#${background}", "#${color15}"],
    "vim.statusBarColors.insert": ["#${color6}", "#${background}"],
    "vim.statusBarColors.visual": "#${color3}",
    "vim.statusBarColors.visualline": "#${color3}",
    "vim.statusBarColors.visualblock": "#${color3}",
    "vim.statusBarColors.replace": "#990000",
    "vim.statusBarColors.commandlineinprogress": ["#00bb00", "#${background}"],
    "vim.statusBarColors.searchinprogressmode": ["#00bb00", "#${background}"],
    "vim.statusBarColors.easymotionmode": ["#00bb00", "#${background}"],
    "vim.statusBarColors.easymotioninputmode": ["#00bb00", "#${background}"],
    "vim.statusBarColors.surroundinputmode": ["#00bb00", "#${background}"],
    "workbench.colorCustomizations": {
        "terminal.background": "#${background}",
        "terminal.foreground": "#${foreground}",
        "terminalCursor.foreground": "#${cursor}",
        "terminalCursor.background": "#${cursor_text_color}",
        "terminal.ansiBlack": "#${color0}",
        "terminal.ansiBrightBlack": "#${color8}",
        "terminal.ansiRed": "#${color1}",
        "terminal.ansiBrightRed": "#${color9}",
        "terminal.ansiGreen": "#${color2}",
        "terminal.ansiBrightGreen": "#${color10}",
        "terminal.ansiYellow": "#${color3}",
        "terminal.ansiBrightYellow": "#${color11}",
        "terminal.ansiBlue": "#${color4}",
        "terminal.ansiBrightBlue": "#${color12}",
        "terminal.ansiMagenta": "#${color5}",
        "terminal.ansiBrightMagenta": "#${color13}",
        "terminal.ansiCyan": "#${color6}",
        "terminal.ansiBrightCyan": "#${color14}",
        "terminal.ansiWhite": "#${color7}",
        "terminal.ansiBrightWhite": "#${color15}"
    }
}
